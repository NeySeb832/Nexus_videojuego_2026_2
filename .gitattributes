# Texto: normalizar saltos de línea
* text=auto

# Escenas, prefabs y assets de Unity se guardan como YAML (Force Text)
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf

# Binarios
*.png binary
*.jpg binary
*.fbx binary
*.FBX binary
*.glb binary
*.blend binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
