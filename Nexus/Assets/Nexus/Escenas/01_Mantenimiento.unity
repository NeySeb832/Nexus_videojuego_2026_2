  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_6_11
  quien: "T\xE9cnico del turno de noche"
  alRegistrar:
  - "Otro t\xE9cnico del turno de noche. Muri\xF3 sentado contra la pared, mirando el pedestal del disco."
  - La placa del uniforme dice MENDOZA. Tiene una tableta rota sobre las piernas.
  daObjeto: 0
  objeto: 11
  cantidad: 1
  nombreObjeto: 
  tituloNota: Tableta de Mendoza
  textoNota: "02:58. Llegu\xE9 a la sala B-1. El Disco Maestro 1 sigue en su bah\xEDa.\nSi lo saco, CERBERUS dispara la alarma general y despierta a todas las unidades ancladas en las estaciones de carga del sector.\nLa \xFAnica salida que el sistema no controla es el ascensor de servicio de la cafeter\xEDa. Si alguien termina esto por m\xED: tome el disco y corra. No se detenga."
  visuales: []
  conExtra: 0
  extra: 11
  cantidadExtra: 1
  nombreExtra: Balas de pistola
