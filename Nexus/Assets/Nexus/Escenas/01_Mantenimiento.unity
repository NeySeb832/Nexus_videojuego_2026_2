MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 810294137}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a788f5c5e018fd244bdf6b24d6c2868c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_11_1
  quien: "T\xE9cnico de mantenimiento"
  alRegistrar:
  - "Es un t\xE9cnico de mantenimiento. Tiene el pecho quemado, como si lo hubiera atravesado un soldador."
  - "Junto a su mano hay una bayoneta del kit de emergencia. Intent\xF3 defenderse."
  daObjeto: 1
  objeto: 8
  cantidad: 1
  nombreObjeto: Bayoneta M9
  tituloNota: "Mensaje sin enviar de J. Ram\xEDrez"
  textoNota: "D\xEDa 14, 02:40. Los SENTINEL nos encerraron en la cafeter\xEDa. Dicen que es un fallo de permisos de CERBERUS, pero el panel central ya no le responde a nadie.\nMendoza se fue a la sala de servidores a sacar el disco maestro para forzar el reinicio. No ha vuelto.\nTom\xE9 la bayoneta del kit de emergencia. Si alguien lee esto: no corran cerca de ellos, escuchan los pasos. Y el cuchillo solo sirve si los toman por sorpresa."
  visuales:
  - {fileID: 294775606}
