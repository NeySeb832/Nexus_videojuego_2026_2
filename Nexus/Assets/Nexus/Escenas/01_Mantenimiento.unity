    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[2]'
      value: "Protocolo de Seguridad Androide ACTIVADO. Todo humano en los pasillos ser\xE1 tratado como ANOMAL\xCDA y purgado."
