    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: objetivoAlCompletar
      value: "Busca un fusible de repuesto en el Almac\xE9n (suroeste)"
      objectReference: {fileID: 0}
    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[0]'
      value: "NEXUS OS v3.2 > N\xDACLEO CENTRAL. TEMPERATURA: CR\xCDTICA. REFRIGERACI\xD3N: AL L\xCDMITE."
      objectReference: {fileID: 0}
    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[1]'
      value: "Dos Discos Duros Maestros ya fueron extra\xEDdos. El \xFAltimo est\xE1 en el N\xFAcleo, al norte."
      objectReference: {fileID: 0}
    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[2]'
      value: "La puerta del N\xFAcleo exige la tarjeta AZUL, guardada en la Sala de Control."
      objectReference: {fileID: 0}
    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[3]'
      value: "La Sala de Control no tiene energ\xEDa. Hay un fusible de repuesto en el Almac\xE9n (suroeste)."
      objectReference: {fileID: 0}
    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[4]'
      value: "Cuatro SENTINEL patrullan el pasillo. Al extraer el disco, la purga ser\xE1 total."
