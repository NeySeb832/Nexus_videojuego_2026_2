  m_Script: {fileID: 11500000, guid: a788f5c5e018fd244bdf6b24d6c2868c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_14_19
  quien: Operador Ibarra
  alRegistrar:
  - "Un operador del equipo t\xE1ctico. Lleg\xF3 hasta la v\xE1lvula norte, pero no alcanz\xF3 a abrirla."
  - Tiene dos cartuchos de escopeta en el chaleco.
  daObjeto: 1
  objeto: 12
  cantidad: 2
  nombreObjeto: Cartuchos de escopeta
  tituloNota: Grabadora de Ibarra
  textoNota: "Llegamos al n\xFAcleo cuatro. Salgado y Medina fueron a las v\xE1lvulas de los lados; yo me qued\xE9 con la del norte.\nLas unidades del n\xFAcleo giran en anillos, siempre en el mismo sentido. Si te mueves cuando el anillo ya pas\xF3, no te ven.\nY hay algo m\xE1s grande en una c\xE1psula junto al pasillo sur. No est\xE1 encendido. Todav\xEDa."
  visuales:
  - {fileID: 6232348933656783690}
  conExtra: 0
  extra: 11
  cantidadExtra: 1
  nombreExtra: Balas de pistola
