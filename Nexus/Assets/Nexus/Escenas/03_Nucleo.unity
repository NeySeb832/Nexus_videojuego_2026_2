  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_1_8
  quien: Teniente Salgado
  alRegistrar:
  - "El teniente del equipo t\xE1ctico. La v\xE1lvula oeste est\xE1 a pocos metros: no alcanz\xF3 a abrirla."
  - Tiene balas de pistola y cartuchos de escopeta.
  daObjeto: 1
  objeto: 12
  cantidad: 3
  nombreObjeto: Cartuchos de escopeta
  tituloNota: "\xDAltimo informe del Tte. Salgado"
  textoNota: "Abr\xED la v\xE1lvula del oeste primero y revent\xF3: sobrepresi\xF3n. Las tres se cerraron y el vapor me quem\xF3. Hay un orden; est\xE1 en el manual de la sala de llegada.\nOrtiz, si lees esto: no vayas al disco sin abrir las tres. El escudo quema."
  visuales:
  - {fileID: 3237049129203521199}
  - {fileID: 6552681894051377163}
  conExtra: 1
  extra: 11
  cantidadExtra: 6
  nombreExtra: balas
