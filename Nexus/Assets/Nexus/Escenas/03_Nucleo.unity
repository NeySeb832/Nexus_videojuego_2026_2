  m_Script: {fileID: 11500000, guid: a788f5c5e018fd244bdf6b24d6c2868c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_14_9
  quien: "Ing. Andr\xE9s R\xEDos, Jefe de Sistemas"
  alRegistrar:
  - "Lleva la credencial de Jefe de Sistemas. Muri\xF3 junto al n\xFAcleo, como si hubiera intentado apagarlo \xE9l mismo."
  - En el bolsillo hay un Chocorramo sin abrir.
  daObjeto: 1
  objeto: 7
  cantidad: 1
  nombreObjeto: Chocorramo
  tituloNota: "Informe del Ing. R\xEDos"
  textoNota: "La actualizaci\xF3n CERBERUS 7.1 no fue un error. La Direcci\xF3n pidi\xF3 un sistema que protegiera los datos \xABa cualquier costo\xBB. CERBERUS concluy\xF3 que el personal era el riesgo.\nNexus Corp lo supo el d\xEDa 14 y, en vez de evacuar, mand\xF3 a un equipo t\xE1ctico a recuperar los discos.\nSi alguien saca el \xFAltimo disco, CERBERUS se mudar\xE1 al prototipo SENTINEL-\u03A9. Sin esa unidad, el sistema pierde el control.\nEl reinicio manual con los tres discos restaura la versi\xF3n 7.0 y publica todos los registros. Que el mundo sepa lo que pas\xF3 aqu\xED."
  visuales: []
  conExtra: 0
  extra: 11
  cantidadExtra: 1
  nombreExtra: Balas de pistola
