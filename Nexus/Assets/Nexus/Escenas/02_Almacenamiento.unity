    - target: {fileID: 930163574705796204, guid: 8365994bdc9207e4daec967c4b0454a2, type: 3}
      propertyPath: 'mensajes.Array.data[0]'
      value: "NEXUS OS v3.2 > SECTOR C \xB7 ALMACENAMIENTO MASIVO. ESTADO: DEGRADADO."
