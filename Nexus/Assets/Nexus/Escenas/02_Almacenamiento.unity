  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_12_3
  quien: Operador Vargas
  alRegistrar:
  - "Un operador del equipo t\xE1ctico. Est\xE1 sentado contra la pared, con la pistola todav\xEDa en la mano."
  - "El chaleco est\xE1 perforado de lado a lado. Le quedaban nueve balas."
  daObjeto: 1
  objeto: 9
  cantidad: 1
  nombreObjeto: Pistola M9
  tituloNota: "Registro de la Unidad T\xE1ctica \u2014 Vargas"
  textoNota: "03:10. Entramos siete por la rampa de carga. El contratista habl\xF3 de \xABdrones de vigilancia con un fallo\xBB. No son drones.\nEl 9 mm apenas los frena: hay que meterles medio cargador en el pecho para tumbarlos. Nada de disparos a lo loco.\nPerdimos a Castro en el pasillo B. Ortiz sigui\xF3 hacia el n\xFAcleo con la escopeta. Yo ya no puedo caminar."
  visuales:
  - {fileID: 1965457862}
  - {fileID: 57567830220682920}
  conExtra: 1
  extra: 11
  cantidadExtra: 9
  nombreExtra: balas
