  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_4_8
  quien: Operador Castro
  alRegistrar:
  - "Un operador del equipo t\xE1ctico, con la placa CASTRO. Parece que lo arrastraron hasta aqu\xED."
  - Lleva un cargador de pistola en el chaleco.
  daObjeto: 1
  objeto: 11
  cantidad: 9
  nombreObjeto: Balas de pistola
  tituloNota: "Radio de Castro (\xFAltima transmisi\xF3n)"
  textoNota: "\u2014Castro a Vargas: me separ\xE9 del grupo en el pasillo B. Los racks se mueven... o eso parece. Son tres, no, cuatro unidades.\nMe quedan nueve balas y no pienso gastarlas a ciegas.\n\u2014Vargas a Castro, repite. Castro, \xBFme copias? \xBFCastro?"
  visuales:
  - {fileID: 7770080857856648360}
  conExtra: 0
  extra: 11
  cantidadExtra: 1
  nombreExtra: Balas de pistola
