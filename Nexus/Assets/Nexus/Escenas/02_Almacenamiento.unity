  m_EditorClassIdentifier: Assembly-CSharp::Nexus.Cadaver
  textoAccion: Registrar el cuerpo
  objetivoAlCompletar: 
  id: cadaver_12_12
  quien: "Sargento del equipo t\xE1ctico"
  alRegistrar:
  - "El sargento del equipo t\xE1ctico. Cay\xF3 a pocos metros de la puerta del N\xFAcleo de Datos."
  - "Su escopeta qued\xF3 en el suelo, a su lado. Quedan tres cartuchos en el tubo."
  daObjeto: 1
  objeto: 10
  cantidad: 1
  nombreObjeto: Escopeta Remington 870
  tituloNota: "Orden de misi\xF3n \u2014 Sgto. Ortiz"
  textoNota: "UNIDAD T\xC1CTICA 7 \u2014 ORDEN DE MISI\xD3N. Contratante: Nexus Corp.\nObjetivo: asegurar los tres Discos Duros Maestros antes de que CERBERUS cifre los respaldos. Prioridad: los datos, no el personal.\nEscrito a mano: \xABNos dijeron que eran drones con un fallo de software. Nexus sab\xEDa desde el d\xEDa 14 que las unidades estaban purgando gente. Si salgo de esta, lo cuento todo.\xBB"
  visuales:
  - {fileID: 650001675}
  - {fileID: 5730747189441745031}
  conExtra: 1
  extra: 12
  cantidadExtra: 3
  nombreExtra: cartuchos de escopeta
